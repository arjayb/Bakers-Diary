# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (e.g. Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/bakers_diary"

# JWT signing secret — any long random string
JWT_SECRET="replace-with-a-long-random-string"

# Chef Kats' password, used ONLY by scripts/seed.js to set the initial
# password hash. Never read directly by the running server — the server
# only ever compares against the stored bcrypt hash.
SEED_ADMIN_PASSWORD="replace-with-a-real-password"

# Cloudinary (media storage — see src/services/mediaService.js for why)
CLOUDINARY_CLOUD_NAME="replace-me"
CLOUDINARY_API_KEY="replace-me"
CLOUDINARY_API_SECRET="replace-me"

# USDA FoodData Central — free key from https://api.data.gov/signup/
# Nutrition falls back to "unmatched" gracefully when this is absent; see
# src/services/nutritionProvider.js
USDA_FDC_API_KEY="replace-me"

# Open Food Facts has no API key requirement (public API)

PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
